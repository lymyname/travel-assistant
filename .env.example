# AI Provider: mock | anthropic | openai | kimi | ada | doubao | custom
VITE_AI_PROVIDER=mock

# 通用 API Key（Anthropic / OpenAI / Kimi / Ada 直连 / 直连火山方舟等；会打进前端包，勿提交生产密钥）
VITE_AI_API_KEY=

# 可选：覆盖默认接口地址（OpenAI / Kimi / Ada / 豆包直连）
VITE_AI_API_URL=

# Ada 直连时：Chat Completions 的完整 URL（与下方 ADA_API_BASE 二选一）
VITE_ADA_API_URL=

# 模型或接入点 ID：
# Anthropic: claude-3-haiku-20240307 等
# OpenAI: gpt-3.5-turbo 等
# Kimi（Moonshot）: moonshot-v1-8k（默认）、moonshot-v1-32k、moonshot-v1-128k、kimi-k2 等，见 platform.moonshot.cn 文档
# Ada: 以你们网关文档为准；不设时默认 ada，可用 VITE_AI_MODEL 覆盖
# 豆包（火山方舟）: 控制台「推理接入点」的 ID，格式 ep-xxxx（必填）
VITE_AI_MODEL=

# ---------- Ada（OpenAI 兼容，ada_ 密钥）----------
# VITE_AI_PROVIDER=ada
# 方式 A — 开发代理（推荐，避免 CORS、密钥不进前端包）：
#   VITE_AI_USE_PROXY=true
#   ADA_API_KEY=<ada_ 开头的 Key>
#   ADA_API_BASE=<网关 origin，无路径，如 https://llm.example.com>
#   可选 ADA_PROXY_PATH=/v1/chat/completions（若 Ada 路径不同再改）
# 方式 B — 浏览器直连：
#   VITE_AI_USE_PROXY=false
#   VITE_AI_API_KEY=<ada_ Key>
#   VITE_ADA_API_URL=<完整地址，如 https://host/v1/chat/completions>

# ---------- Kimi（月之暗面 Moonshot）----------
# VITE_AI_PROVIDER=kimi
# VITE_AI_API_KEY=<API Key>（直连浏览器，易被 CORS 拦截，不推荐）
# 推荐本地开发：VITE_AI_USE_PROXY=true ，密钥仅服务端读取（勿加 VITE_ 前缀）：
#   MOONSHOT_API_KEY=<Kimi Key>  或共用下面的 AI_API_KEY=
# 可选 VITE_AI_MODEL，默认 moonshot-v1-8k

# ---------- 豆包 / 火山引擎方舟（推荐，与豆包 App 同类模型）----------
# 1. 在火山引擎开通方舟，创建 API Key 与推理接入点（选择豆包等模型）
# 2. 本地开发推荐：密钥不写进前端
#    - 复制本文件为 .env ，设置：
#      VITE_AI_PROVIDER=doubao
#      VITE_AI_USE_PROXY=true
#      AI_API_KEY=<方舟 API Key>（不要加 VITE_ 前缀，仅开发服务器读取）
#      VITE_AI_MODEL=<你的 ep-xxxx 接入点 ID>
# 3. 直连（会暴露密钥到构建产物，仅适合本地试）：VITE_AI_USE_PROXY 不设或 false，并设置 VITE_AI_API_KEY

VITE_AI_USE_PROXY=false

# 服务端代理用（与 VITE_AI_USE_PROXY=true 配合；勿加 VITE_ 前缀）
AI_API_KEY=
